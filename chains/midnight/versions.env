# Midnight chain version pins
# Midnight uses its own Substrate-based node — NOT cardano-node
# This file is here for consistency but Midnight does NOT use Dockerfile.cardano/apexfusion
# Last updated: 2026-09-17
#
# 1.0.2 notes (midnightntwrk/midnight-node@node-1.0.2, released 2026-09-11):
#   - GitHub still flags the tag prerelease, but Preview RPC is on 1.0.2.
#   - In-place image bump from 1.0.1 on the existing Preview genesis (0x3c096de2…).
#     No chain wipe. Do not jump to 2.1.0-rc.* for Preview.
#   - Upgrade: pull midnight-node:1.0.2 and restart; confirm tip vs
#     rpc.preview.midnight.network.
#
# Prior: node-1.0.1 (2026-07-14) regenerated Preview genesis — that reset is done.

# Midnight node is a pre-built image from midnightntwrk
MIDNIGHT_NODE_IMAGE=midnightntwrk/midnight-node
MIDNIGHT_NODE_VERSION=1.0.2

# Midnight does NOT use:
# - cardano-node (uses Substrate)
# - Guild Operators scripts
# - Mithril
# - CNCLI
# Midnight deployment is handled via its own K3s manifests in chains/midnight/k3s/
