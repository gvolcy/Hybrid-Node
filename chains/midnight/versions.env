# Midnight chain version pins
# Midnight uses its own Substrate-based node — NOT cardano-node
# This file is here for consistency but Midnight does NOT use Dockerfile.cardano/apexfusion
# Last updated: 2026-11-10
#
# 2.1.101 notes (midnightntwrk/midnight-node@node-2.1.101, released 2026-11-08):
#   - Ledger 9 hard-fork / Preview relaunch line. Preview reset on 2026-11-07 as a
#     new chain on 2.1.101; old Preview history is invalid.
#   - Upgrade Preview: pull midnight-node:2.1.101, wipe chain/ledger_storage
#     (keep keystore), restart with --sync warp. Confirm tip vs
#     rpc.preview.midnight.network (tip restarts near genesis after the reset).
#   - Cardano db-sync Postgres must offer TLS. sslmode=disable / ALLOW_NON_SSL
#     no longer work; use sslmode=require (and ssl_root_cert if verifying).
#   - Keep storage_separation=separate (default). Do not jump via 2.1.0-rc.*.
#
# Prior: node-1.0.400 (2026-10-06), node-1.0.300, node-1.0.2, node-1.0.1.

# Midnight node is a pre-built image from midnightntwrk
MIDNIGHT_NODE_IMAGE=midnightntwrk/midnight-node
MIDNIGHT_NODE_VERSION=2.1.101

# Midnight does NOT use:
# - cardano-node (uses Substrate)
# - Guild Operators scripts
# - Mithril
# - CNCLI
# Midnight deployment is handled via its own K3s manifests in chains/midnight/k3s/
