# Midnight chain version pins
# Midnight uses its own Substrate-based node — NOT cardano-node
# This file is here for consistency but Midnight does NOT use Dockerfile.cardano/apexfusion
# Last updated: 2026-09-29
#
# 1.0.300 notes (midnightntwrk/midnight-node@node-1.0.300, released 2026-09-22):
#   - GA on the 1.0.x line. Preview RPC is on 1.0.300. Do not jump to 2.1.0-rc.*
#     for Preview.
#   - In-place image bump from 1.0.1/1.0.2 on the existing Preview genesis
#     (0x3c096de2…). No chain wipe on Preview/Preprod/Mainnet.
#   - Ships a new runtime (spec_version 1000300). An older binary cannot
#     instantiate it and stops importing at set_code. Roll the image before
#     that enactment; Preview has already enacted it.
#   - Upgrade: pull midnight-node:1.0.300 and restart; confirm tip vs
#     rpc.preview.midnight.network.
#
# Prior: node-1.0.2 (2026-09-18), node-1.0.1 (2026-07-14, Preview genesis reset).

# Midnight node is a pre-built image from midnightntwrk
MIDNIGHT_NODE_IMAGE=midnightntwrk/midnight-node
MIDNIGHT_NODE_VERSION=1.0.300

# Midnight does NOT use:
# - cardano-node (uses Substrate)
# - Guild Operators scripts
# - Mithril
# - CNCLI
# Midnight deployment is handled via its own K3s manifests in chains/midnight/k3s/
