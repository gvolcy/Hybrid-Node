# Midnight chain version pins
# Midnight uses its own Substrate-based node — NOT cardano-node
# This file is here for consistency but Midnight does NOT use Dockerfile.cardano/apexfusion
# Last updated: 2026-10-19
#
# 1.0.400 notes (midnightntwrk/midnight-node@node-1.0.400, released 2026-10-06):
#   - GA security patch on the 1.0.x line. Preview RPC is on 1.0.400.
#     Do not jump to 2.1.0-rc.* for Preview.
#   - Binary only. spec_version stays 1000300 (the 1.0.300 runtime already
#     enacted). No governance step and no chain wipe on Preview.
#   - Ledger 8.1.3 rejects non-canonical contract-call encodings that 1.0.300
#     accepted (GHSA-wr7g-rr4v-jmj8).
#   - Upgrade: pull midnight-node:1.0.400 and restart; confirm tip vs
#     rpc.preview.midnight.network.
#
# Prior: node-1.0.300 (2026-09-22, runtime upgrade), node-1.0.2, node-1.0.1.

# Midnight node is a pre-built image from midnightntwrk
MIDNIGHT_NODE_IMAGE=midnightntwrk/midnight-node
MIDNIGHT_NODE_VERSION=1.0.400

# Midnight does NOT use:
# - cardano-node (uses Substrate)
# - Guild Operators scripts
# - Mithril
# - CNCLI
# Midnight deployment is handled via its own K3s manifests in chains/midnight/k3s/
