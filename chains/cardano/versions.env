# Cardano chain version pins
# These are the upstream versions validated for Cardano mainnet/preprod/preview/guild
# Update these when IOG releases new versions and you've tested them
# Last updated: 2026-09-16
#
# Node 11.1.1 notes (IntersectMBO/cardano-node@11.1.1):
#   - Removes the legacy tracing system; TraceOptions / new dispatcher only.
#   - Removes V1 LedgerDB and the LMDB backend; snapshots are Mithril-comparable.
#   - Dijkstra-era prep. Official package table ships cardano-cli 11.2.3.0.
#   - Preview/preprod first. Do not roll BPs around leader slots.
NODE_VERSION=11.1.1
CLI_VERSION=11.2.3.0
GHC_VERSION=9.6.7
CABAL_VERSION=3.12.1.0
HASKELL_IMAGE_TAG=9.6.7-3.12.1.0-3

# Mithril (Cardano-only — not used by ApexFusion)
# Distribution 2630.0 — mithril-signer 1.1.6 (mainnet-compatible; drops CardanoImmutableFilesFull)
MITHRIL_RELEASE=2630.0
MITHRIL_CLIENT_VERSION=0.13.20
MITHRIL_SIGNER_VERSION=1.1.6
MITHRIL_BUILD_HASH=23e124d

# Companion tools
# nview 0.14.0 notes (blinklabs-io/nview@v0.14.0):
#   - container-aware process discovery + multi-instance disambiguation (better
#     node detection inside the k3s/Docker deployment).
#   - prometheus: fixed fullDuplexConns mapping + renamed misleading Duplex column.
#   - prometheus: new Diagnostics view + Mithril sync progress view / governance counter.
#   - epoch progress bar flicker fix. No config/CLI breaking changes.
CNCLI_VERSION=6.7.0
NVIEW_VERSION=0.14.0
TXTOP_VERSION=0.15.0
CARDANO_SIGNER_VERSION=1.35.0

# Guild Operators source
G_ACCOUNT=cardano-community
GUILD_REPO=guild-operators
GUILD_DEPLOY_BRANCH=master
