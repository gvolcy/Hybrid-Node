# Dijkstra testnet version pins (network magic 6)
# Public Cardano testnet preparing the Dijkstra era hard fork.
# https://book.play.dev.cardano.org/environments-pre/dijkstra/
# Last updated: 2026-10-30
#
# Fleet runs IntersectMBO cardano-node 11.2.0 with the book envelope config
# (MinNodeVersion 11.2.0, ExperimentalHardForksEnabled=true) so nodes survive
# the HF. Mainnet/preprod/preview stay on chains/cardano (11.1.3) until 11.2.0
# is marked mainnet-ready — do not bump that pin for this testnet.
#
# Image: thin binary overlay of official 11.2.0 linux-amd64 onto the prior
# Hybrid-Node Dijkstra image (Guild tools + entrypoint retained).
#   ghcr.io/gvolcy/hybrid-node:cardano-11.2.0-dijkstra
# Build:
#   docker build -f platform/docker/Dockerfile.cardano-bin-overlay \
#     --build-arg BASE_IMAGE=ghcr.io/gvolcy/hybrid-node:cardano-11.1.3-dijkstra \
#     -t ghcr.io/gvolcy/hybrid-node:cardano-11.2.0-dijkstra .

NODE_VERSION=11.2.0
NODE_GIT_REV=dac0d7ab2dfdee1f9eda901589e3c6ac8eaa1899
CLI_VERSION=11.6.0.0
IMAGE_TAG=cardano-11.2.0-dijkstra
BASE_IMAGE_TAG=cardano-11.1.3-dijkstra

NETWORK_MAGIC=6
CONFIG_BASE_URL=https://book.play.dev.cardano.org/environments-pre/dijkstra

# Companion tools (inherited from cardano image; not re-pinned here)
CNCLI_VERSION=6.7.0
NVIEW_VERSION=0.14.0
TXTOP_VERSION=0.15.0

# Mithril: not used on Dijkstra testnet
MITHRIL_DOWNLOAD=N
