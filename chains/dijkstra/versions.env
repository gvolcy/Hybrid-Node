# Dijkstra testnet version pins (network magic 6)
# Public Cardano testnet preparing the Dijkstra era hard fork.
# https://book.play.dev.cardano.org/environments-pre/dijkstra/
# Last updated: 2026-11-20
#
# Fleet runs IntersectMBO cardano-node 11.2.1 with the book envelope config
# (MinNodeVersion 11.2.0, ExperimentalHardForksEnabled=true). Intersect
# recommends 11.2.1 for DijkstraNet (snapshot memory + sync snapshot speed;
# LSM approved for BPs). Mainnet/preprod/preview stay on chains/cardano
# (11.1.3) until 11.2.x is marked mainnet-ready.
#
# Image: thin binary overlay of official 11.2.1 linux-amd64 onto the prior
# Hybrid-Node Dijkstra image (Guild tools + entrypoint retained).
#   ghcr.io/gvolcy/hybrid-node:cardano-11.2.1-dijkstra
# Build: GitHub Actions → Build → chain=dijkstra
#   (platform/docker/Dockerfile.cardano-bin-overlay)

NODE_VERSION=11.2.1
NODE_GIT_REV=90bc1cd9380a78a63091ff673f8c5693152c8f60
CLI_VERSION=11.7.0.0
IMAGE_TAG=cardano-11.2.1-dijkstra
BASE_IMAGE_TAG=cardano-11.2.0-dijkstra

NETWORK_MAGIC=6
CONFIG_BASE_URL=https://book.play.dev.cardano.org/environments-pre/dijkstra

# Companion tools (inherited from cardano image; not re-pinned here)
CNCLI_VERSION=6.7.0
NVIEW_VERSION=0.14.0
TXTOP_VERSION=0.15.0

# Mithril: not used on Dijkstra testnet
MITHRIL_DOWNLOAD=N
